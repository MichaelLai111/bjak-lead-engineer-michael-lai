{
  "schema_version": 1,
  "cases": [
    {
      "id": "cv-001",
      "category": "cv_direct",
      "question": "What experience do you have with AI?",
      "expected_status": "answered",
      "must_include": ["AI-assisted claim review", "retrieval-augmented internal assistant"],
      "must_not_include": ["machine learning degree", "AI research scientist"],
      "expected_source_ids": ["resume-redacted-2026"]
    },
    {
      "id": "cv-002",
      "category": "cv_direct",
      "question": "Which frontend technologies have you used?",
      "expected_status": "answered",
      "must_include": ["React", "TypeScript"],
      "must_not_include": ["Angular", "Vue"],
      "expected_source_ids": ["resume-redacted-2026"]
    },
    {
      "id": "cv-003",
      "category": "cv_direct",
      "question": "What degree did you complete?",
      "expected_status": "answered",
