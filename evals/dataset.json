      "must_not_include": ["Master", "PhD"],
      "expected_source_ids": ["resume-redacted-2026"]
    },
    {
      "id": "cv-004",
      "category": "cv_direct",
      "question": "What measurable API performance improvement is documented?",
      "expected_status": "answered",
      "must_include": ["up to 70 percent"],
      "must_not_include": ["guaranteed 70 percent", "more than 70 percent"],
      "expected_source_ids": ["resume-redacted-2026"]
    },
    {
      "id": "cv-005",
      "category": "cv_direct",
